{
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "raw_events",
    "RetryTopic": "send_retry",
    "FailedTopic": "send_failed",
    "DeadLetterTopic": "dead_letter",
    "GroupId": "core-service",
    "RetryGroupId": "core-service-retry",
    "MaxRetryAttempts": 3,
    "AutoOffsetReset": "Earliest"
  },
  "Facebook": {
    "PageAccessToken": "YOUR_PAGE_ACCESS_TOKEN",
    "PageId": "YOUR_PAGE_ID",
    "BaseUrl": "https://graph.facebook.com/v19.0/"
  },
  "Gemini": {
    "ApiKey": "YOUR_GEMINI_API_KEY"
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=coreservice_db;Username=postgres;Password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*"
}
