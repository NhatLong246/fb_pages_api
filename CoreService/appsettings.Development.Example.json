{
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "raw_events",
    "RetryTopic": "send_retry",
    "FailedTopic": "send_failed",
    "DeadLetterTopic": "dead_letter",
    "GroupId": "core-service",
    "RetryGroupId": "core-service-retry",
    "MaxRetryAttempts": 3,
    "AutoOffsetReset": "Earliest"
  },
  "Facebook": {
    "PageAccessToken": "GET_FROM_FB_DEVELOPER_PORTAL",
    "PageId": "YOUR_PAGE_ID",
    "BaseUrl": "https://graph.facebook.com/v19.0/"
  },
  "Gemini": {
    "ApiKey": "YOUR_GEMINI_API_KEY",
    "Model": "gemini-2.5-flash"
  },
  "RateLimit": {
    "MaxEventsPerWindow": 20,
    "WindowSeconds": 60
  },
  "CircuitBreaker": {
    "FailureThreshold": 10,
    "BreakSeconds": 60
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=coreservice_db;Username=postgres;Password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}
